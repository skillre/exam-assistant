# 复制为 .env 后按需填写。此文件只放非敏感/加密种子，绝不放模型 API Key。
# 模型 Key 一律在前端「设置」页填写，加密存进卷内 SQLite（DEC-19）。

# 加密 provider Key 的主密钥（非模型 Key）。
# 不填则 api 首启在卷内生成 data/.app_secret 并持久化——容器重建仍可解密旧 Key。
# 生产建议显式设一个高熵值并妥善保管：openssl rand -hex 32
APP_SECRET=

# 数据根目录（容器内固定 /app/data，一般无需改）
DATA_DIR=/app/data

# 对外暴露的前端端口（宿主机）
WEB_PORT=8080
